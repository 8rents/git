# Git aliases
# ===========
# included via global git config
# https://github.com/8rents/git

# Sections
# ========
# Repository Information and Health
  # status, log, show
# Downloading & Updating Repo
  # clone, pull, fetch
# Staging & Commiting
# Remotes & Uploading
# Branches and past commits


[alias]
  # ================================= 
  # Repository Information and Health
  # =================================

  # Status
  # ------
  # Shows the current state of the repository
  s = status
  sb = status -s -b

  # Log
  # ---
  # Show commits, hashes and messages
  # l, ll, l1, l2
  l = log --oneline --graph --decorate
  # detailed log
  ll = log --graph --decorate
  # fancy 1 line log
  l1 = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  # fancy 2 line log
  l2 = log --graph --pretty=format:'%Cred%h%Creset %C(blue)%d%Creset%Cgreen(%cr)%Creset by %C(bold blue)%an%Creset %d\n %s'




  
  # Show 
  # ====
  # displays the metadata and the exact line-by-line code changes of your very last commit @ HEAD
  sh = show

  # displays patch diff
  # show includes -p  y default
  shp = show -p

  # show with no color
  shnc = show -p --no-color

  # ===========================
  # Downloading & Updating Repo
  # ===========================

  # clone
  # ----
  # Makes a copy of a repository (or at least part of one)
 
  # Always --recurse-sunmodules on clone
  cl = clone --recurse-submodules
  clone = clone --recurse-submodules
  
  # Shallow history clone
  cld = clone --recurse-submodules --depth 
  cld1 = clone --recurse-submodules --depth 1
  cld3 = clone --recurse-submodules --depth 3
  cld10 = clone --recurse-submodules --depth 

  # Fetch
  # =====
  # Like pull but doest merge
  f = fetch
  fo = fetch origin
  fu = fetch upstream

  # Pull
  # ===
  # Like fetcb but merges your working tree
  p = pull
  # Force Pull
  pf = pull -f
  pu = pull -u
  pt = pull --tags
  po = pull origin
  pao = pull --all origin
  pom = pull origin main

  # Staging & Commiting
  # ====================
  
  # Add
  # ------
  # stage files for next commit
  
  # Add command
  a = add
  
  # Add all files in working directory
  aa = add --all

  # add all files interactively
  ai = add -i

  # Commit
  # ------
  # Takes a snapshot of the current branch
  # making an entry in the repos history
  
  # Commit (with detailed message)
  c = commit

  # commit All worktree & write detailed message
  aac = commit -a

  # commit w/ short Message
  cm = commit -m

  # Commit Add all short Message
  caam = commit -am

  # Commit with Empty Message
  cem = commit --allow-empty

  # Amend last commit (fix typo or something)
  cam = commit --amend

  # Add All & AMend last commit
  caaam = commit -a --amend
 
  # Commit AMend Empty Message
  camem = commit --allow-empty --amend
 
  # Commit Add All AMend Empty Message
  caaamem = commit -a --allow-empty --amend
 
  # Push
  # ----
  # Sends updated repository data to another repo
  ps = push
  # Force Push
  psf = push -f  
  psu = push -u
  pst = push --tags
  pso = push origin
  psao = push --all origin
  psom = push origin main

  # psoc = !git push origin $(git bc)
  # psaoc = !git push --all origin $(git bc)
  # psfoc = !git push -f origin $(git bc)
  # psuoc = !git push -u origin $(git bc)
  # psdc = !git push origin :$(git bc)
   

  # ========================
  # Branches and past commits
  # ========================
    
  # Branch
  # ------
  b = branch
 
  # show All branches
  ba = branch -a
 
  # Delete branch
  bd = branch -d
  bdd = branch -D
  br = branch -r
  bc = rev-parse --abbrev-ref HEAD
  bu = !git rev-parse --abbrev-ref --symbolic-full-name "@{u}"
  bs = !git-branch-status

  # Checkout
  # --------

  # checkout a new brach
  ob = checkout -b 

  # checkout a commit
  o = checkout

  # Remote
  # ------
  # Add, edit, delete remote repositories
  r = remote
 
  # add a new remote
  ra = remote add
 
  # Remove remote
  rrm = remote rm

  # Remote View
  rv = remote -v

  # Remote rename
  rrn = remote rename

  # remote prune
  rp = remote prune

  # remote show
  rs = remote show
 
  # Remote Add Origin
  rao = remote add origin

  # Remote Add Upstream
  rau = remote add upstream

  # Remote Remove Origin
  rrmo = remote remove origin

  # Remote Remove Upstream
  rrmu = remote remove upstream
  # Remote Show Origin
  rso = remote show origin
  # Show Upstream
  rsu = remote show upstream
  rpo = remote prune origin
  rpu = remote prune upstream
  
  # Cherry Pick
  # -----------
  # Apply changes from old commits to current commit 
  cp = cherry-pick
  cpa = cherry-pick --abort
  cpc = cherry-pick --continue
  
  # Merge
  # ----
  # Resolve conflicts between 2 or more files
  m = merge
  ma = merge --abort
  mc = merge --continue
  ms = merge --skip
  
  # Diff
  # ----
  # Compare 2 or more versions of a file
  d = diff
  dp = diff --patience
  dc = diff --cached
  dk = diff --check
  dck = diff --cached --check
  dt = difftool
  dct = difftool --cached
     
  # Submodules
  # ----------
  # Working with repos within repos
  
  # Add a new submodule
  subadd = !sh -c 'git submodule add.u://github.com/$1

  # Remove a submodule
  subrm = !sh -c 'git submodule deinit -f $1 &&5 rm -rf .git/modules/$1 && git rm -f $1' -

  # Update all Submodules
  subup = submodule update --init --recursive
  
  # Tag a submodule
  subpull = submodule foreach 'git pull --tags -f origin main || git pull --tags -f origin main'  
  
  # Apply
  # -----
  # The git apply command takes a local patch file (the output of git diff) and applies the changes directly to your local working directory files. Unlike merge or am it does not create a commit or affect history.
  ap = apply
  as = apply --st 
  # Email Operations
  # ================

  # am (Apply Mailbox)
  # ==================
  # Takes a series of emailed patch files and automatically applies them as structured commits to your current branch.
  ama = am --abort
  amr = am --resolved
  ams = am --skip

  # Format Patch
  # ------------
  # command converts specific Git commits into plaintext patch files (formatted as email messages) so you can share your code changes via email or apply them to another repository.
  fp = format-patch

  # =================  
  # Rewriting History
  # =================  
  
  # Rebase
  # ------
  rb = rebase
  rba = rebase --abort
  rbc = rebase --continue
  rbi = rebase --interactive
  rbs = rebase --skip
  
  # Reset, Restore, Revert
  # ----------------------
  # Reset - 
  # Revert - goes back to a previous commit by moving forward
  
  # Reset
  # -----
  # Rewinds history resetting it backward. Best solution for single person repos since history is undone.
  # Undoes commits and staging
  # Note: HEAD is default commit, but head can be replaced with any commit hash 

  # Mixed (default): Rolls commit back,  Resets staging, not working tree (files) 
  res = reset
  # is equal to:
      # reset
      #=reset HEAD
      #=reset --mixed
      #=reset --mixed HEAD
  
  # Hard - Rolls commit back and Resets both staging (index) & files (working tree)
  resh = reset --hard
#=resh = reset --hard HEAD
  
  # Soft - Rolls commit back, leaves staging (index) & files (worktree) altered ready to be committed again.
  ress = reset --soft
 #=res = reset --soft HEAD


  # Restore (reset without undoing commits)
  # ------
  # For shared branches on unpushed commits that need to be undone
  # undoes files and staging and makes commits going forward in time
  rest = restore --worktree
  rests = restore --staged

  # Revert
  # ------
  # For shared branches that have been pushed pushing an inverse commit
  rev



  # File & Worktree Operations
  # ==========================

  # rm (remove)
  # -----------
 
  # force
  rmf = rm -f
  
  # force & recurse (into dirs)
  rmrf = rm -r -f

  
  # fsck
  # ----
  # verifies the connectivity and validity of the objects in your Git database, helping you identify and recover corrupt or lost data.
  fk = fsck
   
  # grep
  # ----
  g = grep -p

  # List
  # ----
  ls  = ls-files
  lsf = !git ls-files | grep -i

  # Prune
  # -----
  # pr = prune -v

  # Stash
  # -----
  sa = stash apply
  sc = stash clear
  sd = stash drop
  sl = stash list
  sp = stash pop
  ss = stash save
  ssk = stash save -k
  sw = stash show
  st = !git stash list | wc -l 2>/dev/null | grep -oEi '[0-9][0-9]*'
  