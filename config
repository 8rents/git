# User Level Global Git Config for Android
# ======================================== 
# Sets config options for all of the git projects for the current user 
# Repo: github.com/8rents/git
# Last Updated: 2026-07-03


[safe]
# Set a folder for safe execution of code

  directory = *
    # * makes all directories on the file system safe


[init]
# Settings for when git initializes
  
  defaultBranch = blank
  # Set the default branch name 
  
  templateDir = ~/dotfiles/git/config.d/repos/default
  # Path to directory for git tempalates
  # Default templateDir is at: `/usr/share/git-core/templates`
  

[core]
# Core behavior of git
  
  editor = nano
  # Preffered Text Editor
  # code, subl, mate, nano, vim

  pager = less
  # Command line pager for git
  # less, most, delta
  
  excludesfile = ignore
  # Path to external excludes file 
  
  whitespace = trailing-space,space-before-tab,indent-with-non-tab
  # How to handle and detect whitespace issues, values separated with a comma
  # trailing-space - Shorthand for blank-at-eol and blank-at-eof
    # blank-at-eol - Finds spaces/tabs at the end of a line.
    # blank-at-eof - Notices blank lines at the very end of a file.
  # space-before-tab - Finds spaces before tabs at the start of a line.
  # indent-with-non-tab - Flags lines starting with spaces instead of tabs (uses tabwidth).
  # tab-in-indent - Flags tabs used within the indentation of a line.
  # cr-at-eol - Treats carriage returns (Windows-style) as valid (not errors).

  autocrlf = input
  # how to handle line endings when moving files between your computer (working reww) and the Git repository (index)
  # true - Windows - Converts LF to CRLF on checkout; CRLF to LF on commit
  # input - macOS / Linux - No change on checkout; converts CRLF to LF on commit.
  # false - (Same-OS Teams) No conversion happens. Files are saved exactly as they are.

  pager = delta 
  # Command line pager for git
  # less, most, delta
  
[fetch]
# Fetch settings

  # Always prune deleted remote branches when fetching
  prune = true

  # Pull all submodules when cloning
  recurseSubmodules = true

[push]
# Push Settings

  # whether or not to assume --set-upstream on default push when no upstream tracking
  autoSetupRemote = true
  
  # ensure all submodule commits are available on a remote-tracking branch
  # recurseSubmodules = true  
 
  # whether or not to GPG-sign pushes
  # gpgSign = true	


[filter "lfs"]
# Git Large File Storage (LFS) replaces large files such as audio samples, videos, datasets, and graphics with text pointers
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[web]
# Git web / browser settings

  # Browser git should open if you don't want it to open the system default
  # browser = cromite
	
[rerere]
  # The git rerere functionality is a bit of a hidden feature.The name stands for "reuse recorded resolution" and, as the name implies, it allows you to ask Git to remember how you've resolved a hunk conflict before so that the next time it sees the same conflict, Git can resolve it for you automatically.
  enabled = 1
  autoupdate = 1

# Gitflow
[gitflow "prefix"]
  versiontag = v
  
[credential "https://github.com"]
# GitHub Credentials
  khelper = !/data/data/com.termux/files/usr/bin/gh auth git-credensinglekey
   helper = !/data/data/com.termux/files/usr/bin/gh auth git-credential
  # whether or not to accept one-letter input withouttia
	
[credential "https://gist.github.com"]
# GitHub Gists Credentials
	helper = !/data/data/com.termux/files/usr/bin/gh auth git-credential


[commit]
# Chose the style of commit template. Comment out all template lines to use the default template

  # Conventional (Better for automation & pipelines)
  template = ~/dotfiles/git/config.d/messages/commit/conventional

  # Human Readable (Easier for people to read)
  # template = ~/dotfiles/git/templates/messages/commit/human-readable

[include]
# External files to include into this config file

  # 8rents@gmail.com user configs
  path = config.d/users/brent.gitconfig

  # Custom color options
  path = config.d/color/auto.gitconfig

  # Custom abbriviated git commands aliases (ex. commit --all = ca)
  path = config.d/aliases/abbr.gitconfig
  path = config.d/aliases/macros.gitconfig

  # Set Delta as pager with dark catppuccin theme
  path = config.d/pagers/delta/dark-catppuccin-mocha.gitconfig