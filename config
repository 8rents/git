# External files to include into this .config file
[include]
  path = aliases

# Core behavior of git
[core]

  # Pager - set command line pager
  pager = delta
  
  # Preffered Text Editor
  editor = subl # code, subl, mate, nano, vin
  
  # Path to external excludes file 
  excludesfile = ignore
  
  # How to handle and detect whitespace issues
  whitespace = trailing-space,space-before-tab,indent-with-non-tab,cr-at-eol
  # Possible Values:
    # trailing-space - Shorthand for blank-at-eol and blank-at-eof
      # blank-at-eol - Finds spaces/tabs at the end of a line.
      # blank-at-eof - Notices blank lines at the very end of a file.
    # space-before-tab - Finds spaces before tabs at the start of a line.
    # indent-with-non-tab - Flags lines starting with spaces instead of tabs (uses tabwidth).
    # tab-in-indent - Flags tabs used within the indentation of a line.
    # cr-at-eol - Treats carriage returns (Windows-style) as valid (not errors).

  # how to handle line endings when moving files between your computer (working reww) and the Git repository (index)
  autocrlf = true
  # Possible Values:
    # true - Converts LF to CRLF on checkout; CRLF to LF on commit
      # Use true for Windows
    # input - 
      # No change on checkout; converts CRLF to LF on commit.
        # Use input for macOS / Linux
    # false
      # No conversion happens. Files are saved exactly as they are.
        # Use false for Same-OS Teams

# Set all local directories to safe
[safe]
  directory = *
  # * makes all directories on the file system safe


# Set the local git users credentials
[user]
  # Name of User
  name = Brenton Holiday
  
  # Users email address
  email = 8rents@gmail.com

  # Display username
  username = 8rents


[init]
  # Set the default branch name
  defaultBranch = main

  # Path to directory for git tempalates
  # templateDir = 

# Git Large File Storage (LFS) replaces large files such as audio samples, videos, datasets, and graphics with text pointers
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true


[web]
  # Preffered Web Browser
  browser = google-chrome


# On Fetch configuration
[fetch]
  # Always prune deleted remote branches when fetching
  prune = true

  # Pull all submodules when cloning
  recurseSubmodules = true


# The git rerere functionality is a bit of a hidden feature. The name stands for "reuse recorded resolution" and, as the name implies, it allows you to ask Git to remember how you’ve resolved a hunk conflict so that the next time it sees the same conflict, Git can resolve it for you automatically.
[rerere]
  enabled = 1
  autoupdate = 1


# Sublime merge "smerge" as Merge & Diff tool

# Merge Tool
[merge]
    tool = smerge
[mergetool "smerge"]
    cmd = smerge mergetool \"$BASE\" \"$LOCAL\" \"$REMOTE\" -o \"$MERGED\"
    trustExitCode = true

# Diff Tool
[diff]
    tool = smerge
[difftool "smerge"]
    cmd = smerge \"$LOCAL\" \"$REMOTE\"


# Gitflow
[gitflow "prefix"]
  versiontag = v

# GitHub credentials
[github]
  user = 8rents
  token = token